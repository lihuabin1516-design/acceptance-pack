{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paneforge.acceptance.request.v1",
  "title": "PaneForge Acceptance Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "taskId", "runId", "workspaceId", "sources"],
  "properties": {
    "schema": { "const": "paneforge.acceptance.request.v1" },
    "taskId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "workspaceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256", "required"],
        "properties": {
          "kind": { "enum": ["workflow-index", "verification-summary", "acceptance-evidence", "acceptance-verification", "audit"] },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "required": { "type": "boolean" }
        }
      }
    }
  }
}
