{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ccpanes.acceptance.pack.v1",
  "title": "CC-Panes Acceptance Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generatedAt",
    "status",
    "taskId",
    "runId",
    "workspaceId",
    "workflowStatus",
    "checks",
    "sources",
    "blockingReasons",
    "missingOptional",
    "advisoryOnly"
  ],
  "properties": {
    "schema": { "const": "ccpanes.acceptance.pack.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["ready", "partial", "blocked"] },
    "taskId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "workspaceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "workflowStatus": { "type": "string" },
    "bootstrapStatus": { "type": "string", "enum": ["CREATED", "BOOTSTRAPPING", "ACTIVE", "SYSTEM_ERROR", "BOOTSTRAP_PROTOCOL_ERROR", "COMPLETED"] },
    "bootstrapStarted": { "type": "boolean" },
    "checks": {
      "type": "object",
      "additionalProperties": { "enum": ["pass", "fail", "blocked", "not-run"] }
    },
    "completionAllowed": { "type": "boolean" },
    "truthLayers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "state", "required"],
        "properties": {
          "name": { "type": "string" },
          "state": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    },
    "artifactResults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "status"],
        "properties": {
          "path": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": { "enum": ["workflow-index", "verification-summary", "acceptance-evidence", "acceptance-verification", "bootstrap-evidence", "audit"] },
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "blockingReasons": { "type": "array", "items": { "type": "string" } },
    "missingOptional": { "type": "array", "items": { "type": "string" } },
    "advisoryOnly": { "const": true }
  }
}
